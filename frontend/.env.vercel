# Vercel Environment Variables Configuration
# This file documents the environment variables needed for Vercel deployment

# PRODUCTION
# Add to Vercel > Settings > Environment Variables (Production)
VITE_API_BASE_URL=https://your-backend-domain.com/api
VITE_WS_URL=wss://your-backend-domain.com/ws

# PREVIEW
# Add to Vercel > Settings > Environment Variables (Preview)
# VITE_API_BASE_URL=https://preview-backend.your-domain.com/api
# VITE_WS_URL=wss://preview-backend.your-domain.com/ws

# DEVELOPMENT (Local)
# For local development, use the .env.local file
# VITE_API_BASE_URL=http://localhost:8080/api
# VITE_WS_URL=ws://localhost:8080/ws

# Notes:
# - All variables must be prefixed with VITE_ to be accessible in the frontend
# - WebSocket URLs should use wss:// (secure) in production
# - Backend API can be hosted on Heroku, Railway, AWS, or any server
